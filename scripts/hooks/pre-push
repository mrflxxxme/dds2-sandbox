#!/usr/bin/env bash
# DDS Pre-push hook — прогоняет тесты перед пушем
# Пропустить: git push --no-verify (ТОЛЬКО для экстренных случаев)

echo "🔍 Pre-push: запуск проверок..."

# ─── Цвета ───────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

FAILED=0
SKIPPED=0
ROOT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"

# ─── Проверка Docker ────────────────────────────────────────────────
DOCKER_OK=0
if command -v docker &>/dev/null && docker compose ps --format '{{.Name}}' 2>/dev/null | grep -q backend; then
    DOCKER_OK=1
fi

# ─── 1. Backend тесты (testmon + xdist -n 2, ~10-20 сек) ─────────────
# Note: -n 2 (не auto) — auto спавнит по CPU count, на Docker с ограничением
# RAM (обычно 2GB) приводит к OOM (exit 137). 2 worker'а = оптимум для 4-8 CPU
echo ""
echo "━━━ Backend tests (testmon + xdist -n 2) ━━━"
if [ "$DOCKER_OK" -eq 1 ]; then
    if docker compose exec -T backend pytest --testmon -n 2 --tb=short -q 2>/dev/null; then
        echo -e "${GREEN}✓ Backend tests passed${NC}"
    else
        echo -e "${RED}✗ Backend tests FAILED${NC}"
        FAILED=1
    fi
else
    echo -e "${YELLOW}⚠ SKIPPED — Docker/backend не запущен (make dev)${NC}"
    SKIPPED=1
fi

# ─── 2. Frontend тесты (~20-30 сек) ─────────────────────────────────
echo ""
echo "━━━ Frontend tests (vitest) ━━━"
if [ -d "frontend-react/node_modules" ] && command -v npx &>/dev/null; then
    if (cd frontend-react && npx vitest run --reporter=dot 2>/dev/null); then
        echo -e "${GREEN}✓ Frontend tests passed${NC}"
    else
        echo -e "${RED}✗ Frontend tests FAILED${NC}"
        FAILED=1
    fi
else
    echo -e "${YELLOW}⚠ SKIPPED — node_modules не установлены (cd frontend-react && npm i)${NC}"
    SKIPPED=1
fi

# ─── 3. Convention checks (~5 сек) ──────────────────────────────────
echo ""
echo "━━━ Conventions ━━━"
CONV_OUTPUT=$(bash "$ROOT_DIR/scripts/check_conventions.sh" 2>&1)
CONV_EXIT=$?
# Show only last 5 lines (summary) to avoid pipe buffer overflow
echo "$CONV_OUTPUT" | tail -5
if [ $CONV_EXIT -eq 0 ]; then
    echo -e "${GREEN}✓ Conventions passed${NC}"
else
    echo -e "${RED}✗ Conventions FAILED${NC}"
    echo "$CONV_OUTPUT" | grep -E '(FAIL|ERROR|✗)' | head -10
    FAILED=1
fi

# ─── 4. Slopsquatting защита (~3-10 сек) ────────────────────────────
echo ""
echo "━━━ Slopsquatting check (new imports) ━━━"
if bash "$ROOT_DIR/scripts/hooks/check_slopsquatting.sh" 2>&1; then
    echo -e "${GREEN}✓ All new imports are real packages${NC}"
else
    echo -e "${RED}✗ Suspicious package(s) detected — AI галлюцинация?${NC}"
    FAILED=1
fi

# ─── Результат ──────────────────────────────────────────────────────
echo ""
if [ $FAILED -ne 0 ]; then
    echo -e "${RED}━━━ PUSH BLOCKED: исправь ошибки выше ━━━${NC}"
    echo -e "${YELLOW}Экстренный пуш: git push --no-verify${NC}"
    exit 1
fi

if [ $SKIPPED -ne 0 ]; then
    echo -e "${YELLOW}━━━ WARNING: часть проверок пропущена (Docker/npm не готовы) ━━━${NC}"
    echo -e "${YELLOW}Рекомендуется: make dev && прогнать тесты перед merge в main${NC}"
fi

echo -e "${GREEN}━━━ Checks passed — pushing ━━━${NC}"
exit 0
