# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=dds
POSTGRES_PASSWORD=dds_secret
POSTGRES_DB=dds_db
# Async DB (через PgBouncer, порт 6432) — prepared_statement_cache_size=0 обязателен!
DATABASE_URL=postgresql+asyncpg://dds:dds_secret@pgbouncer:5432/dds_db?prepared_statement_cache_size=0
# Sync DB (напрямую к PostgreSQL, порт 5432) — для Alembic и ETL
DATABASE_URL_SYNC=postgresql://dds:dds_secret@db:5432/dds_db

# ─── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Environment ──────────────────────────────────────────────────────────────
DDS_ENV=development
# DDS_ENV=staging
# DDS_ENV=production

# ─── Container role ──────────────────────────────────────────────────────────
# api = HTTP serving (6 workers), worker = scheduler + background tasks (1 worker)
DDS_ROLE=api

# ─── Database pool ────────────────────────────────────────────────────────────
# Tuned for PgBouncer transaction pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ─── Observability ────────────────────────────────────────────────────────────
# Sentry DSN — оставить пустым для отключения
SENTRY_DSN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:dds_redis_secret@redis:6379/0
REDIS_PASSWORD=dds_redis_secret

# ─── MinIO (S3-compatible storage) ────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО: сменить на безопасные значения в production!
# Local: minio:9000 (MinIO в том же docker network)
# Production/Staging: 10.0.0.1:9000 (Data-сервер через WireGuard)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your-access-key-here
MINIO_SECRET_KEY=your-secret-key-here
MINIO_BUCKET=dds-files
MINIO_SECURE=false

# ─── Frontend ─────────────────────────────────────────────────────────────────
API_URL=http://backend:8000
