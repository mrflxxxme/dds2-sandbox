# ─── Окружение изолированной песочницы (контур Р16) ──────────────────────────
# Скопируйте этот файл в КОРЕНЬ репозитория под именем .env:
#     cp docs/specs/design/sandbox.env.example .env
#
# Значения ниже — рабочие дефолты ДЛЯ ЛОКАЛЬНОЙ ПЕСОЧНИЦЫ. Порты привязаны к
# 127.0.0.1, наружу стек не смотрит. Не использовать в проде, не публиковать.
# Внешние интеграции (WB, Telegram, AI) выключены — песочница никуда не ходит.

# --- Обязательные: без них docker compose откажется стартовать ---
POSTGRES_USER=dds
POSTGRES_DB=dds_db
POSTGRES_PASSWORD=sandbox_pg_local
REDIS_PASSWORD=sandbox_redis_local
REDIS_URL=redis://:sandbox_redis_local@redis:6379/0
MINIO_ACCESS_KEY=sandboxminio
MINIO_SECRET_KEY=sandboxminio_local
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=dds-files
MINIO_SECURE=false

# --- Аутентификация ---
# Любая длинная случайная строка. Своя: openssl rand -hex 32
SECRET_KEY=sandbox_only_replace_with_openssl_rand_hex_32_value
# Нужен, чтобы создать первого пользователя через POST /api/v1/auth/register.
# После создания учётки можно выставить false и пересоздать backend.
REGISTER_ENABLED=true

# --- Изоляция от внешнего мира (в песочнице не трогать) ---
DDS_ENV=development
SCHEDULER_ENABLED=false
FULFILLMENT_SYNC_ENABLED=false
WB_FBS_ENABLED=false
FEATURE_WB_SYNC=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=0
TELEGRAM_BOT_TOKEN_ANALYTICS=
TELEGRAM_USE_POLLING=false
ANTHROPIC_API_KEY=

# --- Прочее ---
CORS_ORIGINS=http://127.0.0.1:13000,http://localhost:13000
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
