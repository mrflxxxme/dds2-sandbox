# Alertmanager Configuration — routes Prometheus alerts to Telegram
#
# !!! TEMPLATE ONLY — NOT USED IN CI DEPLOY !!!
#
# alertmanager v0.27.0 does NOT interpolate ${ENV_VAR} syntax in this file.
# `chat_id` is parsed as int64 directly, so a literal "${TELEGRAM_CHAT_ID}"
# string fails YAML unmarshal and puts the container in a restart loop.
# (Incident 2026-04-14 — run 24387021986 of deploy-monitoring.yml.)
#
# The actual production alertmanager.yml lives ONLY on the monitoring server
# at /opt/dds_monitoring/monitoring/alertmanager.yml with credentials
# hardcoded. It is excluded from rsync deploy via --exclude='alertmanager.yml'
# in .github/workflows/deploy-monitoring.yml.
#
# To set up a new monitoring server, copy this file to alertmanager.yml on
# the server and replace ${TELEGRAM_BOT_TOKEN} / ${TELEGRAM_CHAT_ID} with
# literal values.

global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: telegram

  routes:
    # Critical alerts — send immediately
    - match:
        severity: critical
      group_wait: 10s
      repeat_interval: 1h
      receiver: telegram

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: '${TELEGRAM_BOT_TOKEN}'
        chat_id: ${TELEGRAM_CHAT_ID}
        parse_mode: HTML
        message: |
          {{ if eq .Status "firing" }}🔴{{ else }}🟢{{ end }} <b>{{ .Status | toUpper }}</b>

          {{ range .Alerts }}
          <b>{{ .Labels.alertname }}</b> [{{ .Labels.severity }}]
          {{ .Annotations.summary }}
          {{ if .Annotations.description }}{{ .Annotations.description }}{{ end }}
          {{ end }}
