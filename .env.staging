# ──────────────────────────────────────────────────────────────
# DDS Staging Environment
# Скопировать в .env на staging-сервере
# ──────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=dds
POSTGRES_PASSWORD=staging_secret_change_me
POSTGRES_DB=dds_staging_db
DATABASE_URL=postgresql+asyncpg://dds:staging_secret_change_me@db:5432/dds_staging_db
DATABASE_URL_SYNC=postgresql://dds:staging_secret_change_me@db:5432/dds_staging_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:staging_redis_secret@redis:6379/0
REDIS_PASSWORD=staging_redis_secret

# ─── MinIO ────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=staging_minio_secret
MINIO_BUCKET=dds-files
MINIO_SECURE=false

# ─── App ──────────────────────────────────────────────────────
SECRET_KEY=staging-secret-key-minimum-32-characters-long-change-me
DDS_ENV=staging
REGISTER_ENABLED=true

# ─── Sentry (опционально) ────────────────────────────────────
# SENTRY_DSN=
