# ─── Builder stage ────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build
COPY requirements-backend.txt .
RUN pip install --no-cache-dir --prefix=/install --timeout=120 --retries=5 -r requirements-backend.txt

# ─── Runtime stage ────────────────────────────────────────────────────────────
FROM python:3.11-slim

# Non-root user for security
RUN addgroup --system app && adduser --system --ingroup app app

WORKDIR /app

COPY --from=builder /install /usr/local

COPY backend/ ./backend/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY pytest.ini .
COPY pyproject.toml .
COPY migrations/ ./migrations/
COPY alembic.ini .
COPY entrypoint.sh .
COPY entrypoint-worker.sh .

# ─── КриптоПро CSP (для VTB ИБК H2H: csptest-подпись + cprocsp-curl GOST-TLS) ──
# По умолчанию ВЫКЛ → прод-CI собирается без него (дистрибутив gitignored, в git его нет).
# Включить:  docker build --build-arg INSTALL_CRYPTOPRO=1   (нужен docker/cryptopro/linux-amd64_deb.tgz
# в build-контексте; на ARM-Mac добавить --platform=linux/amd64). Bind-mount → 38 МБ не оседают в слое.
ARG INSTALL_CRYPTOPRO=0
ENV PATH="/opt/cprocsp/bin/amd64:/opt/cprocsp/sbin/amd64:${PATH}"
# docker/cryptopro/ всегда в git (Dockerfile тест-рига); *.tgz gitignored → в прод-CI
# COPY тащит только мелочь, а RUN при =0 пропускает установку. Слой 38 МБ возникает
# лишь при сборке VTB-образа (--build-arg INSTALL_CRYPTOPRO=1 с дистрибутивом на месте).
COPY docker/cryptopro/ /tmp/cryptopro/
RUN if [ "$INSTALL_CRYPTOPRO" = "1" ]; then \
        apt-get update && apt-get install -y --no-install-recommends procps && rm -rf /var/lib/apt/lists/* \
        && cd /tmp/cryptopro && tar xzf linux-amd64_deb.tgz && cd linux-amd64_deb \
        && bash install.sh && (dpkg -i cprocsp-pki-cades-64_*.deb || true) ; \
    fi \
    && rm -rf /tmp/cryptopro

RUN chmod +x entrypoint.sh entrypoint-worker.sh \
    && mkdir -p /data/ai_memory \
    && chown -R app:app /app /data
USER app

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

ENTRYPOINT ["./entrypoint.sh"]
# gunicorn-мастер, а не голый uvicorn: рециркуляция воркера по max-requests
# (защита от роста памяти — на 768M ловили OOM, см. docker-compose.app.yml)
# происходит под мастером, который держит слушающий сокет. Запросы ждут в
# backlog вместо 502. У uvicorn --limit-max-requests умирал единственный
# процесс → рестарт контейнера с alembic → ~15с сплошных 502 (01.08.2026).
CMD ["gunicorn", "backend.main:app", \
     "--worker-class", "uvicorn_worker.UvicornWorker", \
     "--workers", "1", \
     "--bind", "0.0.0.0:8000", \
     "--max-requests", "5000", \
     "--max-requests-jitter", "500", \
     "--timeout", "300", \
     "--graceful-timeout", "60", \
     "--keep-alive", "120", \
     "--no-control-socket", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
