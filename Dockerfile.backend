# ─── Builder stage ────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build
COPY requirements-backend.txt .
RUN pip install --no-cache-dir --prefix=/install --timeout=120 --retries=5 -r requirements-backend.txt

# ─── Runtime stage ────────────────────────────────────────────────────────────
FROM python:3.11-slim

# Non-root user for security
RUN addgroup --system app && adduser --system --ingroup app app

WORKDIR /app

COPY --from=builder /install /usr/local

COPY backend/ ./backend/
COPY tests/ ./tests/
COPY pytest.ini .
COPY pyproject.toml .
COPY migrations/ ./migrations/
COPY alembic.ini .
COPY entrypoint.sh .
COPY entrypoint-worker.sh .

RUN chmod +x entrypoint.sh entrypoint-worker.sh && chown -R app:app /app
USER app

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

ENTRYPOINT ["./entrypoint.sh"]
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--timeout-keep-alive", "120", "--limit-max-requests", "10000"]
