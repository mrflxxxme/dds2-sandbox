{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "frontend-react"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "frontend-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend-react && BACKEND_URL=http://localhost:8000 npm run dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "backend",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "backend"],
      "port": 8000
    }
  ]
}
