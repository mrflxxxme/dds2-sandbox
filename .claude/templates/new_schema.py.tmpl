from datetime import datetime
from decimal import Decimal

from pydantic import BaseModel, ConfigDict, Field


# ─── Response (read) ──────────────────────────────────────────────────────────


class XxxResponse(BaseModel):
    """Serialized Xxx returned by API endpoints."""

    model_config = ConfigDict(from_attributes=True)  # enables ORM mode

    id: int
    project_id: int
    name: str
    description: str | None = None
    amount: Decimal | None = None              # RULE: Decimal for money (never float)
    created_at: datetime
    updated_at: datetime


# ─── Create ───────────────────────────────────────────────────────────────────


class XxxCreate(BaseModel):
    """Input payload for creating a new Xxx."""

    name: str = Field(..., min_length=1, max_length=200)
    description: str | None = None
    amount: Decimal | None = Field(default=None, ge=0)  # RULE: Decimal for money

    # Optional id: present → upsert; absent → create
    id: int | None = None


# ─── Update ───────────────────────────────────────────────────────────────────


class XxxUpdate(BaseModel):
    """Input payload for partial update of Xxx (all fields optional)."""

    name: str | None = Field(default=None, min_length=1, max_length=200)
    description: str | None = None
    amount: Decimal | None = Field(default=None, ge=0)


