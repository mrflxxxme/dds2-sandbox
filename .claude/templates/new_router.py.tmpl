"""
Router: /xxx — CRUD endpoints for Xxx domain.

Delegates ALL business logic to services/xxx_service.py.
No logic here — only HTTP plumbing (parse → call service → return).
"""

from fastapi import APIRouter, Depends, HTTPException
from sqlalchemy.ext.asyncio import AsyncSession

from backend.database import get_db
from backend.models import Project
from backend.project_context import get_current_project
from backend.schemas.xxx import XxxCreate, XxxResponse, XxxUpdate  # TODO: replace with real schemas
from backend.services import xxx_service  # TODO: replace with real service module
from backend.utils.rate_limit import rate_limit_write  # RULE: write endpoints carry this dependency

router = APIRouter(prefix="/xxx")  # TODO: replace with real prefix, e.g. "/orders"


# ─── List ─────────────────────────────────────────────────────────────────────


@router.get("", response_model=list[XxxResponse])
async def list_xxx(
    project: Project = Depends(get_current_project),  # resolves X-Project-Id header → Project
    db: AsyncSession = Depends(get_db),
):
    """List all active Xxx records for the current project."""
    return await xxx_service.list_xxx(db, project.id)


# ─── Get one ──────────────────────────────────────────────────────────────────


@router.get("/{xxx_id}", response_model=XxxResponse)
async def get_xxx(
    xxx_id: int,
    project: Project = Depends(get_current_project),
    db: AsyncSession = Depends(get_db),
):
    """Get a single Xxx by id."""
    obj = await xxx_service.get_xxx(db, project.id, xxx_id)
    if not obj:
        raise HTTPException(status_code=404, detail="Xxx not found")
    return obj


# ─── Create ───────────────────────────────────────────────────────────────────


@router.post("", response_model=XxxResponse, dependencies=[Depends(rate_limit_write)])
async def create_xxx(
    payload: XxxCreate,
    project: Project = Depends(get_current_project),
    db: AsyncSession = Depends(get_db),
):
    """Create a new Xxx record."""
    # Light validation only — heavy logic stays in service
    return await xxx_service.create_xxx(db, project.id, payload.model_dump(exclude_unset=True))


# ─── Update ───────────────────────────────────────────────────────────────────


@router.patch("/{xxx_id}", response_model=XxxResponse, dependencies=[Depends(rate_limit_write)])
async def update_xxx(
    xxx_id: int,
    payload: XxxUpdate,
    project: Project = Depends(get_current_project),
    db: AsyncSession = Depends(get_db),
):
    """Partial update of an Xxx record."""
    obj = await xxx_service.update_xxx(db, project.id, xxx_id, payload.model_dump(exclude_unset=True))
    if not obj:
        raise HTTPException(status_code=404, detail="Xxx not found")
    return obj


# ─── Upsert (create-or-update) ────────────────────────────────────────────────


@router.post("/upsert", response_model=XxxResponse, dependencies=[Depends(rate_limit_write)])
async def upsert_xxx(
    payload: XxxCreate,  # reuse Create schema; id optional inside
    project: Project = Depends(get_current_project),
    db: AsyncSession = Depends(get_db),
):
    """Create or update Xxx (id in body → update; no id → create)."""
    return await xxx_service.upsert_xxx(db, project.id, payload.model_dump(exclude_unset=True))


# ─── Delete ───────────────────────────────────────────────────────────────────


@router.delete("/{xxx_id}", dependencies=[Depends(rate_limit_write)])
async def delete_xxx(
    xxx_id: int,
    project: Project = Depends(get_current_project),
    db: AsyncSession = Depends(get_db),
):
    """Soft-delete an Xxx record."""
    deleted = await xxx_service.delete_xxx(db, project.id, xxx_id)
    if not deleted:
        raise HTTPException(status_code=404, detail="Xxx not found")
    return {"ok": True}


