{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "1",
    "ENABLE_PROMPT_CACHING_1H": "1"
  },
  "effortLevel": "high",
  "fallbackModel": ["claude-sonnet-5", "claude-haiku-4-5"],
  "cleanupPeriodDays": 21,
  "permissions": {
    "allow": [
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:anthropic.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "mcp__Claude_in_Chrome",
      "mcp__Claude_Preview",
      "mcp__computer-use",
      "Skill(webapp-testing)",
      "Skill(webapp-testing:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/pre_tool_check.sh",
            "timeout": 3
          }
        ],
        "description": "Блокировать опасные команды + доступ к .env/credentials"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/hooks/post_edit_check.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/hooks/frontend_check.py",
            "timeout": 5
          }
        ],
        "description": "Smart DDS conventions: backend (is_deleted, project_id, soft_delete, Float, SQL injection, router logic, rate_limit_write) + frontend (raw fetch, page states)"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/post_stop_check.sh",
            "timeout": 10
          }
        ],
        "description": "Float в моделях + напоминание обновить документацию"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/prompt-team-detect.sh",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/hooks/prompt_quality_check.py",
            "timeout": 3
          }
        ],
        "description": "[PUSH] при фейле авто-пуша + счётчик /compact + ТЗ-гейт: расплывчатый промпт (баг без указателя, «ничего не изменилось», дизайн без референса) → агент сначала задаёт уточняющие вопросы"
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/session_start.sh",
            "timeout": 5
          }
        ],
        "description": "Auto-context: recent commits, branch sync, uncommitted, pending /learn"
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/session_start.sh",
            "timeout": 2
          }
        ],
        "description": "Reset /compact counter при compact/clear"
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/teammate_idle_check.sh",
            "timeout": 15
          }
        ],
        "description": "Quality gate перед idle worktree-teammate: iron rules (Float/utcnow/db.delete/f-string SQL), types-first FE, абсолютные пути, check_conventions.sh. Exit 2 → teammate получит feedback и продолжит фиксить, не возвращая управление lead-агенту"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/pre_compact_snapshot.sh",
            "timeout": 5
          }
        ],
        "description": "Снапшот git-состояния (status/diffstat/pending-learn) в .claude/.pre-compact-latest.log перед компактом — защита in-flight контекста в длинных сессиях"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bash scripts/hooks/subagent_findings_aggregate.sh",
            "timeout": 3
          }
        ],
        "description": "Лёгкий breadcrumb завершения субагентов в .claude/.last-review.log (append, cap 200 строк)"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash scripts/statusline.sh"
  }
}
