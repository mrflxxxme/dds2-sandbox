{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-4-8"
  },
  "effortLevel": "medium",
  "permissions": {
    "allow": [
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/pre_tool_check.sh",
            "timeout": 3
          }
        ],
        "description": "Блокировать опасные команды + доступ к .env/credentials"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hooks/post_edit_check.py",
            "timeout": 5
          }
        ],
        "description": "Smart DDS conventions: is_deleted, project_id, soft_delete, Float, SQL injection, router logic"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/post_stop_check.sh",
            "timeout": 10
          }
        ],
        "description": "Float в моделях + напоминание обновить документацию"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/prompt-team-detect.sh",
            "timeout": 3
          }
        ],
        "description": "Напоминание [DOCS] при pending docs-коммитах + счётчик /compact"
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/session_start.sh",
            "timeout": 5
          }
        ],
        "description": "Auto-context: recent commits, branch sync, uncommitted, pending /learn, open CI issues, docker health"
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/session_start.sh",
            "timeout": 2
          }
        ],
        "description": "Reset /compact counter при compact/clear"
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/teammate_idle_check.sh",
            "timeout": 15
          }
        ],
        "description": "Quality gate перед idle worktree-teammate: iron rules (Float/utcnow/db.delete/f-string SQL), types-first FE, абсолютные пути, check_conventions.sh. Exit 2 → teammate получит feedback и продолжит фиксить, не возвращая управление lead-агенту"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/a1/Desktop/dds_app/scripts/statusline.sh"
  }
}
